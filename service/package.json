{
  "name": "ct-connector-service",
  "version": "1.0.0",
  "private": true,
  "description": "commercetools Connect service implementing a Cart create API Extension for validation",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "start": "node dist/index.js",
    "start:dev": "tsx watch src/index.ts",
    "build": "tsc",
    "test": "vitest run",
    "connector:post-deploy": "echo \"post-deploy: nothing to do\"",
    "connector:pre-undeploy": "echo \"pre-undeploy: nothing to do\"",
    "register-extension": "node --env-file=.env --import tsx scripts/register-extension.ts"
  },
  "dependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.10",
    "express": "^4.19.2",
    "typescript": "^5.5.3"
  },
  "devDependencies": {
    "@types/supertest": "^7.2.1",
    "supertest": "^7.2.2",
    "tsx": "^4.16.2",
    "vitest": "^4.1.11"
  }
}
