PORT=8080
CTP_PROJECT_KEY=your-project-key
CTP_CLIENT_ID=your-client-id
CTP_CLIENT_SECRET=your-client-secret
CTP_AUTH_URL=https://auth.europe-west1.gcp.commercetools.com
CTP_API_URL=https://api.europe-west1.gcp.commercetools.com
# Needs the manage_subscriptions:{projectKey} scope this time, not manage_extensions.
CTP_SCOPES=your-scope-string

# QSTASH_DESTINATION_URL is the /api/receive endpoint of the separate qstash-receiver proof app
# (github.com/dineshvadalacompose/qstash-receiver) - QStash delivers each forwarded event there,
# so delivery can be visually confirmed on that app's page.
QSTASH_DESTINATION_URL=https://qstash-receiver-phi.vercel.app/api/receive
QSTASH_TOKEN=your-qstash-token

# CONNECT_GCP_TOPIC_NAME and CONNECT_GCP_PROJECT_ID are injected automatically by commercetools
# Connect in a real deployed environment - they are not set here for local dev. That also means
# postDeploy's registration script isn't practical to run locally the way service/'s was; local
# dev of this app only lets you exercise the /event decode-and-log logic directly, not a real
# Subscription registration.
# CONNECT_GCP_TOPIC_NAME=
# CONNECT_GCP_PROJECT_ID=
